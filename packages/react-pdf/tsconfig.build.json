{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/cjs",
    "declarationDir": "./dist/types",
    "module": "CommonJS",
    "rootDir": "./src",
    "declaration": true,
    "moduleResolution": "node",
    "paths": {
      "@dblimp/core": ["packages/core/dist/types/index"],
      "@dblimp/core/*": ["packages/core/dist/types/*"]
    },
    "baseUrl": "../.."
  },
  "include": ["src/**/*"]
}
