{
  "name": "@dblimp/core",
  "version": "0.1.1",
  "description": "Core framework components",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts",
      "source": "./src/index.ts"
    },
    "./component": {
      "import": "./dist/esm/component.js",
      "types": "./dist/types/component.d.ts",
      "source": "./src/component.tsx"
    },
    "./goat": {
      "import": "./dist/esm/goat.js",
      "types": "./dist/types/goat.d.ts",
      "source": "./src/goat.tsx"
    },
    "./components": {
      "import": "./dist/esm/components.js",
      "types": "./dist/types/components.d.ts",
      "source": "./src/components.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:cjs": "tsc -p tsconfig.build.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "tsc -p tsconfig.esm.json",
    "test": "jest --config ./jest.config.ts",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-router-dom": "^7.0.0",
    "dbl-utils": "^1.0.12"
  },
  "dependencies": {
    "css-element-queries": "^1.2.3",
    "html-react-parser": "^5.2.2",
    "url-join": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "dbl-utils": "^1.0.12"
  },
  "type": "module",
  "files": [
    "dist/",
    "src/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
