{
  "view": {
    "name": [
      "$props/name",
      "blogPostContainer"
    ],
    "content": {
      "info": {
        "name": [
          "$props/name",
          "info"
        ],
        "tag": "section",
        "classes": "$props/infoClasses",
        "content": {
          "resumeGrid": {
            "name": [
              "$props/name",
              "resumeGrid"
            ],
            "component": "GridContainer",
            "classes": "gx-2 align-items-end mb-2",
            "colClasses": [
              "auto-xs-12 auto-sm-4 auto-md-4 auto-lg-3 auto-xl-3 auto-xxl-3",
              ""
            ],
            "content": [
              {
                "tag": "div",
                "name": [
                  "$props/name",
                  "imageWrapper"
                ],
                "component": "ProportionalContainer",
                "content": {
                  "name": [
                    "$props/name",
                    "image"
                  ],
                  "component": "Image",
                  "src": "$props/image",
                  "imageClasses": "w-100 h-100",
                  "classes": "w-100 h-100 mb-0"
                }
              },
              {
                "name": [
                  "$props/name",
                  "intro"
                ],
                "tag": "div",
                "classes": "",
                "content": [
                  {
                    "name": [
                      "$props/name",
                      "titleBP"
                    ],
                    "tag": "h2",
                    "classes": [
                      "border-bottom pb-2 mb-5",
                      "text-primary border-primary"
                    ],
                    "content": [
                      {
                        "name": [
                          "$props/name",
                          "icon"
                        ],
                        "component": "Icons",
                        "classes": "d-inline-block align-text-bottom me-2",
                        "inline": false,
                        "width": "3rem",
                        "icon": "$props/icon"
                      },
                      "$props/title"
                    ]
                  },
                  "$props/resume"
                ]
              }
            ]
          },
          "children": {
            "name": [
              "$props/name",
              "children"
            ],
            "tag": "div"
          }
        }
      },
      "gallery": {
        "name": [
          "$props/name",
          "gallery"
        ],
        "tag": "section",
        "component": "SlideContainer",
        "content": []
      }
    }
  },
  "definitions": {
    "slide": {
      "component": "Image",
      "src": "$data/image",
      "imageClasses": "w-100 h-100",
      "width": "100%",
      "height": 200
    }
  }
}