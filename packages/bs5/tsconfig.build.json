{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/cjs",
    "declarationDir": "./dist/types",
    "module": "CommonJS",
    "rootDir": "./src",
    "declaration": true,
    "moduleResolution": "node",
    "paths": {
      "@dblimp/core": ["packages/core/dist/types/index"],
      "@dblimp/core/*": ["packages/core/dist/types/*"],
      "@dblimp/icomoon": ["packages/icomoon/dist/types/index"],
      "@dblimp/floating": ["packages/floating/dist/types/index"]
    },
    "baseUrl": "../.."
  },
  "include": ["src/**/*"],
  "exclude": ["src/__tests__/**/*", "**/*.test.ts", "**/*.test.tsx"]
}
